#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONNECTION_NAME="wipi-ap"

die() {
  printf 'wipi: %s\n' "$*" >&2
  exit 1
}

require_root() {
  [[ ${EUID} -eq 0 ]] || die "run this command with sudo"
}

connection_exists() {
  nmcli --terse --fields NAME connection show | grep -Fxq "${CONNECTION_NAME}"
}

show_status() {
  connection_exists || die "access point is not installed"

  local state device ssid address
  state=$(nmcli -g GENERAL.STATE connection show "${CONNECTION_NAME}" 2>/dev/null || true)
  device=$(nmcli -g GENERAL.DEVICES connection show "${CONNECTION_NAME}" 2>/dev/null || true)
  ssid=$(nmcli -g 802-11-wireless.ssid connection show "${CONNECTION_NAME}")
  address=$(nmcli -g ipv4.addresses connection show "${CONNECTION_NAME}")

  printf 'Access point: %s\n' "${state:-inactive}"
  printf 'SSID:         %s\n' "${ssid}"
  printf 'Interface:    %s\n' "${device:--}"
  printf 'Pi address:   %s\n' "${address}"

  if [[ -n ${device} && ${device} != "--" ]] && command -v iw >/dev/null 2>&1; then
    printf '\nConnected clients:\n'
    iw dev "${device}" station dump |
      awk '/^Station / { mac=$2 } /signal:/ { printf "  %s  signal %s %s\n", mac, $2, $3 }'
  fi
}

show_diagnostics() {
  connection_exists || die "access point is not installed"

  local device wireless_fields
  device=$(nmcli -g GENERAL.DEVICES connection show "${CONNECTION_NAME}" 2>/dev/null || true)
  wireless_fields="GENERAL.STATE,GENERAL.DEVICES,802-11-wireless.ssid,802-11-wireless.channel,802-11-wireless.powersave"
  if nmcli --fields 802-11-wireless.channel-width connection show "${CONNECTION_NAME}" \
    >/dev/null 2>&1; then
    wireless_fields="${wireless_fields},802-11-wireless.channel-width"
  fi

  printf '== System ==\n'
  sed -n 's/^PRETTY_NAME=//p' /etc/os-release 2>/dev/null || true
  uname -a
  nmcli --version

  printf '== NetworkManager ==\n'
  nmcli --fields "${wireless_fields}" connection show "${CONNECTION_NAME}"

  printf '\n== Devices ==\n'
  nmcli device status

  if [[ -n ${device} && ${device} != "--" ]] && command -v iw >/dev/null 2>&1; then
    printf '\n== Wi-Fi link ==\n'
    iw dev "${device}" info
    iw dev "${device}" get power_save 2>/dev/null || true
    iw dev "${device}" station dump

    printf '\n== Regulatory domain ==\n'
    iw reg get

    printf '\n== Channel survey ==\n'
    iw dev "${device}" survey dump 2>/dev/null || true
  fi

  if command -v rfkill >/dev/null 2>&1; then
    printf '\n== Radio blocks ==\n'
    rfkill list wifi
  fi

  if command -v vcgencmd >/dev/null 2>&1; then
    printf '\n== Pi power/thermal flags ==\n'
    vcgencmd get_throttled
  fi

  printf '\n== Recent Wi-Fi events ==\n'
  journalctl --no-pager -n 80 -u NetworkManager 2>/dev/null |
    grep -Ei 'wlan|wifi|wipi|brcm|deauth|disconnect|fail|error' || true

  printf '\n== Recent kernel Wi-Fi events ==\n'
  journalctl --no-pager -b -k 2>/dev/null |
    grep -Ei 'brcm|wlan|cfg80211|firmware.*(crash|fail|error)|mmc.*error' |
    tail -n 80 || true
}

show_help() {
  cat <<'EOF'
Usage: sudo wipi COMMAND

Commands:
  status      Show access-point state and connected clients
  diagnose    Show radio, power, and recent disconnect information
  start       Start the access point
  stop        Stop the access point
  restart     Restart the access point
  uninstall   Remove the access-point configuration and this command
EOF
}

main() {
  case ${1:-status} in
    status)
      command -v nmcli >/dev/null 2>&1 || die "NetworkManager is not installed"
      show_status
      ;;
    diagnose)
      command -v nmcli >/dev/null 2>&1 || die "NetworkManager is not installed"
      show_diagnostics
      ;;
    start)
      require_root
      command -v nmcli >/dev/null 2>&1 || die "NetworkManager is not installed"
      connection_exists || die "access point is not installed"
      nmcli connection up "${CONNECTION_NAME}"
      ;;
    stop)
      require_root
      command -v nmcli >/dev/null 2>&1 || die "NetworkManager is not installed"
      connection_exists || die "access point is not installed"
      nmcli connection down "${CONNECTION_NAME}"
      ;;
    restart)
      require_root
      command -v nmcli >/dev/null 2>&1 || die "NetworkManager is not installed"
      connection_exists || die "access point is not installed"
      nmcli connection down "${CONNECTION_NAME}" >/dev/null 2>&1 || true
      nmcli connection up "${CONNECTION_NAME}"
      ;;
    uninstall)
      require_root
      if command -v nmcli >/dev/null 2>&1 && connection_exists; then
        nmcli connection delete "${CONNECTION_NAME}"
      fi
      rm -f /usr/local/sbin/wipi
      printf 'wipi has been removed\n'
      ;;
    help|-h|--help)
      show_help
      ;;
    *)
      show_help >&2
      exit 2
      ;;
  esac
}

main "$@"
