#!/usr/bin/env bash
set -Eeuo pipefail

readonly WIPI_VERSION="2.1.0"
readonly CONNECTION_NAME="wipi"
readonly LEGACY_CONNECTION_NAME="wipi-ap"
readonly SERVICE_NAME="wipi.service"
readonly DNS_SERVICE_NAME="wipi-dnsmasq.service"
readonly ROUTING_TABLE_ID="4242"
readonly ROUTING_TABLE_NAME="wipi"
readonly POLICY_RULE_PRIORITY="10424"
readonly DEFAULT_ADDRESS="10.10.0.1/24"
readonly OLD_DEFAULT_ADDRESS="10.42.0.1/24"
readonly TEST_ROOT="${WIPI_TEST_ROOT:-}"

root_path() {
  printf '%s%s\n' "${TEST_ROOT}" "$1"
}

CONFIG_DIR=$(root_path /etc/wipi)
readonly CONFIG_DIR
readonly CONFIG_FILE="${CONFIG_DIR}/wipi.conf"
RUN_DIR=$(root_path /run/wipi)
readonly RUN_DIR
STATE_DIR=$(root_path /var/lib/wipi)
readonly STATE_DIR
UNIT_FILE=$(root_path /etc/systemd/system/wipi.service)
readonly UNIT_FILE
DNS_UNIT_FILE=$(root_path /etc/systemd/system/wipi-dnsmasq.service)
readonly DNS_UNIT_FILE
ROUTING_TABLE_FILE=$(root_path /etc/iproute2/rt_tables.d/wipi.conf)
readonly ROUTING_TABLE_FILE
DISPATCHER_FILE=$(root_path /etc/NetworkManager/dispatcher.d/90-wipi)
readonly DISPATCHER_FILE
INSTALLED_COMMAND=$(root_path /usr/local/bin/wipi)
readonly INSTALLED_COMMAND
readonly SYSTEMD_COMMAND="/usr/local/bin/wipi"

readonly -a CONFIG_KEYS=(
  WIPI_INTERFACE
  WIPI_SSID
  WIPI_PASSWORD
  WIPI_ADDRESS
  WIPI_HOSTNAME
  WIPI_COUNTRY
  WIPI_BAND
  WIPI_CHANNEL
  WIPI_MODE
  WIPI_UPSTREAM_INTERFACE
)

declare -a ENV_OVERRIDE_KEYS=()
declare -a ENV_OVERRIDE_VALUES=()
APT_UPDATED=0
OPTION_COUNT=0
BAND_WAS_OVERRIDDEN=0
CHANNEL_WAS_OVERRIDDEN=0
UPSTREAM_WAS_OVERRIDDEN=0
CONFIG_MIGRATED=0
AP_IPV4=""
AP_SUBNET=""
AP_NETMASK=""
DHCP_START=""
DHCP_END=""
UPSTREAM_IPV4=""
UPSTREAM_SUBNET=""
UPSTREAM_GATEWAY=""
UPSTREAM_ROUTE_LINES=""
PINNED_DNS_SERVERS=""

log() {
  printf '[wipi] %s\n' "$*"
}

warn() {
  printf '[wipi] warning: %s\n' "$*" >&2
}

die() {
  printf '[wipi] error: %s\n' "$*" >&2
  exit 1
}

require_root() {
  if [[ ${WIPI_TEST_MODE:-0} == "1" ]]; then
    return
  fi
  [[ ${EUID} -eq 0 ]] || die "run this command with sudo"
}

require_no_arguments() {
  local command=$1
  shift
  (($# == 0)) || die "'${command}' does not accept arguments"
}

require_linux() {
  if [[ ${WIPI_TEST_MODE:-0} == "1" ]]; then
    return
  fi
  [[ $(uname -s) == "Linux" ]] || die "this command only supports Linux"
  [[ -r /etc/os-release ]] || die "cannot identify this Linux distribution"

  local os_id
  os_id=$(sed -n 's/^ID=//p' /etc/os-release | tr -d '"')
  [[ ${os_id} == "raspbian" || ${os_id} == "debian" ]] ||
    die "supported systems are Raspberry Pi OS and Debian"
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

capture_environment_overrides() {
  local key
  for key in "${CONFIG_KEYS[@]}"; do
    if declare -p "${key}" >/dev/null 2>&1; then
      ENV_OVERRIDE_KEYS+=("${key}")
      ENV_OVERRIDE_VALUES+=("${!key}")
    fi
  done
}

set_defaults() {
  WIPI_INTERFACE="wlan0"
  WIPI_SSID="wipi"
  WIPI_PASSWORD=""
  WIPI_ADDRESS="${DEFAULT_ADDRESS}"
  WIPI_HOSTNAME="wipi.local"
  WIPI_COUNTRY="US"
  WIPI_BAND="2.4"
  WIPI_CHANNEL="6"
  WIPI_MODE="isolated"
  WIPI_UPSTREAM_INTERFACE=""
}

migrate_old_default_address() {
  if [[ ${WIPI_ADDRESS} == "${OLD_DEFAULT_ADDRESS}" ]]; then
    WIPI_ADDRESS="${DEFAULT_ADDRESS}"
    CONFIG_MIGRATED=1
    log "migrating the former default AP address to ${DEFAULT_ADDRESS}"
  fi
}

is_config_key() {
  local candidate=$1
  local key
  for key in "${CONFIG_KEYS[@]}"; do
    [[ ${candidate} == "${key}" ]] && return 0
  done
  return 1
}

decode_config_value() {
  local encoded=$1
  local decoded="" char next
  local index=0

  while ((index < ${#encoded})); do
    char=${encoded:index:1}
    if [[ ${char} != "\\" ]]; then
      decoded+="${char}"
      ((index += 1))
      continue
    fi

    ((index += 1))
    ((index < ${#encoded})) ||
      die "invalid trailing escape in ${CONFIG_FILE}"
    next=${encoded:index:1}
    case ${next} in
      \\|'"'|'$'|'`') decoded+="${next}" ;;
      *) die "unsupported escape in ${CONFIG_FILE}" ;;
    esac
    ((index += 1))
  done

  printf '%s\n' "${decoded}"
}

encode_config_value() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//\$/\\\$}
  value=${value//\`/\\\`}
  printf '%s\n' "${value}"
}

load_config() {
  [[ -r ${CONFIG_FILE} ]] || return 0

  local line key encoded value line_number=0
  while IFS= read -r line || [[ -n ${line} ]]; do
    ((line_number += 1))
    [[ -z ${line} || ${line} =~ ^[[:space:]]*# ]] && continue
    if [[ ! ${line} =~ ^([A-Z_]+)=\"(.*)\"$ ]]; then
      die "invalid configuration syntax at ${CONFIG_FILE}:${line_number}"
    fi
    key=${BASH_REMATCH[1]}
    encoded=${BASH_REMATCH[2]}
    is_config_key "${key}" ||
      die "unexpected configuration key '${key}' at ${CONFIG_FILE}:${line_number}"
    value=$(decode_config_value "${encoded}")
    printf -v "${key}" '%s' "${value}"
  done <"${CONFIG_FILE}"
}

apply_environment_overrides() {
  local index
  for ((index = 0; index < ${#ENV_OVERRIDE_KEYS[@]}; index += 1)); do
    printf -v "${ENV_OVERRIDE_KEYS[index]}" '%s' \
      "${ENV_OVERRIDE_VALUES[index]}"
    case ${ENV_OVERRIDE_KEYS[index]} in
      WIPI_BAND) BAND_WAS_OVERRIDDEN=1 ;;
      WIPI_CHANNEL) CHANNEL_WAS_OVERRIDDEN=1 ;;
      WIPI_UPSTREAM_INTERFACE) UPSTREAM_WAS_OVERRIDDEN=1 ;;
    esac
  done
}

write_config() {
  install -d -m 700 "${CONFIG_DIR}"

  local temporary key encoded
  temporary=$(mktemp "${CONFIG_FILE}.tmp.XXXXXX")
  chmod 600 "${temporary}"
  for key in "${CONFIG_KEYS[@]}"; do
    encoded=$(encode_config_value "${!key}")
    printf '%s="%s"\n' "${key}" "${encoded}" >>"${temporary}"
  done
  mv -f "${temporary}" "${CONFIG_FILE}"
  chmod 600 "${CONFIG_FILE}"
}

generate_password() {
  local generated
  generated=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
  printf '%s\n' "${generated}"
}

normalize_band() {
  local normalized
  normalized=$(printf '%s' "${WIPI_BAND}" | tr '[:upper:]' '[:lower:]')
  case ${normalized} in
    2.4|2.4ghz|bg)
      WIPI_BAND="2.4"
      NM_BAND="bg"
      ;;
    5|5ghz|a)
      WIPI_BAND="5"
      NM_BAND="a"
      ;;
    *)
      die "band must be 2.4 or 5"
      ;;
  esac
}

contains_control_character() {
  local LC_ALL=C
  [[ $1 =~ [[:cntrl:]] ]]
}

validate_interface_name() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,14}$ ]] ||
    die "invalid interface name '$1'"
}

validate_ssid() {
  local LC_ALL=C
  local value=$1
  ((${#value} >= 1 && ${#value} <= 32)) ||
    die "SSID must contain 1 to 32 bytes"
  ! contains_control_character "${value}" ||
    die "SSID must not contain control characters"
}

validate_password() {
  local LC_ALL=C
  local value=$1
  ((${#value} >= 8 && ${#value} <= 63)) ||
    die "password must contain 8 to 63 bytes"
  ! contains_control_character "${value}" ||
    die "password must not contain control characters"
}

validate_country() {
  WIPI_COUNTRY=$(printf '%s' "${WIPI_COUNTRY}" |
    tr '[:lower:]' '[:upper:]')
  [[ ${WIPI_COUNTRY} =~ ^[A-Z]{2}$ ]] ||
    die "country must be a two-letter code"
}

validate_ipv4_octet() {
  [[ $1 =~ ^[0-9]{1,3}$ ]] || return 1
  [[ $1 == "0" || $1 != 0* ]] || return 1
  ((10#$1 >= 0 && 10#$1 <= 255))
}

ipv4_to_int() {
  local address=$1 first second third fourth value
  IFS=. read -r first second third fourth <<<"${address}"
  validate_ipv4_octet "${first:-}" &&
    validate_ipv4_octet "${second:-}" &&
    validate_ipv4_octet "${third:-}" &&
    validate_ipv4_octet "${fourth:-}" || return 1
  value=$(( \
    (10#${first} << 24) |
      (10#${second} << 16) |
      (10#${third} << 8) |
      10#${fourth} \
  ))
  printf '%u\n' "${value}"
}

int_to_ipv4() {
  local value=$1
  printf '%d.%d.%d.%d\n' \
    "$(((value >> 24) & 255))" \
    "$(((value >> 16) & 255))" \
    "$(((value >> 8) & 255))" \
    "$((value & 255))"
}

cidr_network() {
  local cidr=$1 address prefix address_int mask network
  [[ ${cidr} =~ ^([^/]+)/([0-9]+)$ ]] || return 1
  address=${BASH_REMATCH[1]}
  prefix=${BASH_REMATCH[2]}
  ((prefix >= 0 && prefix <= 32)) || return 1
  address_int=$(ipv4_to_int "${address}") || return 1
  if ((prefix == 0)); then
    mask=0
  else
    mask=$(((0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF))
  fi
  network=$((address_int & mask))
  printf '%s/%s\n' "$(int_to_ipv4 "${network}")" "${prefix}"
}

cidr_bounds() {
  local cidr=$1 network_cidr prefix network_int mask broadcast
  network_cidr=$(cidr_network "${cidr}") || return 1
  prefix=${network_cidr#*/}
  network_int=$(ipv4_to_int "${network_cidr%/*}") || return 1
  if ((prefix == 0)); then
    mask=0
  else
    mask=$(((0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF))
  fi
  broadcast=$((network_int | ((~mask) & 0xFFFFFFFF)))
  printf '%s %s\n' "${network_int}" "${broadcast}"
}

cidrs_overlap() {
  local first_bounds second_bounds first_start first_end second_start second_end
  first_bounds=$(cidr_bounds "$1") || return 1
  second_bounds=$(cidr_bounds "$2") || return 1
  read -r first_start first_end <<<"${first_bounds}"
  read -r second_start second_end <<<"${second_bounds}"
  ((first_start <= second_end && second_start <= first_end))
}

validate_address() {
  local address prefix octet
  local -a octets

  [[ ${WIPI_ADDRESS} =~ ^([^/]+)/([0-9]+)$ ]] ||
    die "address must be an IPv4 CIDR"
  address=${BASH_REMATCH[1]}
  prefix=${BASH_REMATCH[2]}
  [[ ${prefix} == "24" ]] ||
    die "WiPi currently supports /24 AP networks only"

  IFS=. read -r -a octets <<<"${address}"
  ((${#octets[@]} == 4)) || die "address must be an IPv4 CIDR"
  for octet in "${octets[@]}"; do
    validate_ipv4_octet "${octet}" || die "address must be an IPv4 CIDR"
  done
  ((10#${octets[3]} >= 1 && 10#${octets[3]} <= 254)) ||
    die "AP address cannot be the network or broadcast address"
  AP_IPV4=${address}
  AP_SUBNET=$(cidr_network "${WIPI_ADDRESS}") ||
    die "address must be an IPv4 CIDR"
  AP_NETMASK="255.255.255.0"
}

validate_hostname() {
  local hostname=${WIPI_HOSTNAME%.}
  local label
  local -a labels

  ((${#hostname} >= 1 && ${#hostname} <= 253)) ||
    die "hostname must contain 1 to 253 characters"
  [[ ${hostname} =~ ^[A-Za-z0-9.-]+$ ]] ||
    die "hostname contains invalid characters"
  IFS=. read -r -a labels <<<"${hostname}"
  for label in "${labels[@]}"; do
    ((${#label} >= 1 && ${#label} <= 63)) ||
      die "hostname labels must contain 1 to 63 characters"
    [[ ${label} =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] ||
      die "hostname labels cannot start or end with a hyphen"
  done
  WIPI_HOSTNAME=$(printf '%s' "${hostname}" |
    tr '[:upper:]' '[:lower:]')
}

validate_mode_and_channel() {
  case ${WIPI_MODE} in
    routed|isolated) ;;
    *) die "mode must be routed or isolated" ;;
  esac

  [[ ${WIPI_CHANNEL} =~ ^[0-9]+$ ]] ||
    die "channel must be a number"
  if [[ ${WIPI_BAND} == "2.4" ]]; then
    ((WIPI_CHANNEL >= 1 && WIPI_CHANNEL <= 13)) ||
      die "2.4 GHz channel must be between 1 and 13"
  else
    case ${WIPI_CHANNEL} in
      36|40|44|48) ;;
      *) die "5 GHz channel must be 36, 40, 44, or 48" ;;
    esac
  fi
}

validate_logical_settings() {
  validate_interface_name "${WIPI_INTERFACE}"
  validate_ssid "${WIPI_SSID}"
  validate_password "${WIPI_PASSWORD}"
  validate_address
  validate_hostname
  validate_country
  normalize_band
  validate_mode_and_channel

  if [[ -n ${WIPI_UPSTREAM_INTERFACE} ]]; then
    validate_interface_name "${WIPI_UPSTREAM_INTERFACE}"
    [[ ${WIPI_UPSTREAM_INTERFACE} != "${WIPI_INTERFACE}" ]] ||
      die "upstream interface cannot be the AP interface"
  fi
  if [[ ${WIPI_MODE} == "isolated" ]]; then
    if ((UPSTREAM_WAS_OVERRIDDEN == 1)) &&
      [[ -n ${WIPI_UPSTREAM_INTERFACE} ]]; then
      die "isolated mode cannot use an upstream interface"
    fi
    WIPI_UPSTREAM_INTERFACE=""
  fi
}

collect_upstream_dns() {
  PINNED_DNS_SERVERS=""
  local output line server
  output=$(nmcli --terse --escape no --fields IP4.DNS \
    device show "${WIPI_UPSTREAM_INTERFACE}" 2>/dev/null || true)
  while IFS= read -r line; do
    [[ -n ${line} ]] || continue
    server=${line#*:}
    ipv4_to_int "${server}" >/dev/null 2>&1 || continue
    [[ ${server} != "0.0.0.0" && ${server} != 169.254.* ]] || continue
    if ! grep -Fxq "${server}" <<<"${PINNED_DNS_SERVERS}"; then
      if [[ -n ${PINNED_DNS_SERVERS} ]]; then
        PINNED_DNS_SERVERS+=$'\n'
      fi
      PINNED_DNS_SERVERS+="${server}"
    fi
  done <<<"${output}"
}

validate_pinned_upstream() {
  local interface=${WIPI_UPSTREAM_INTERFACE}
  local link_output flags wireless_info address_lines cidr route_lines
  local route destination useful_route=0 default_route

  [[ ${interface} != wipi* ]] ||
    die "Pinned routed mode cannot start: ${interface} is WiPi-owned."
  link_output=$(ip -o link show dev "${interface}" 2>/dev/null) ||
    die "Pinned routed mode cannot start: ${interface} does not exist."
  flags=${link_output#*<}
  flags=${flags%%>*}
  [[ ,${flags}, == *,UP,* ]] ||
    die "Pinned routed mode cannot start: ${interface} is down."

  local carrier_path="${WIPI_SYS_CLASS_NET_ROOT:-/sys/class/net}/${interface}/carrier"
  if [[ -r ${carrier_path} && $(<"${carrier_path}") != "1" ]]; then
    die "Pinned routed mode cannot start: ${interface} has no carrier."
  fi

  wireless_info=$(iw dev "${interface}" info 2>/dev/null || true)
  if grep -Eq '^[[:space:]]*type[[:space:]]+monitor([[:space:]]|$)' \
    <<<"${wireless_info}"; then
    die "Pinned routed mode cannot start: ${interface} is in monitor mode."
  fi

  address_lines=$(ip -o -4 address show dev "${interface}" \
    scope global 2>/dev/null || true)
  cidr=$(awk '$3 == "inet" && $4 !~ /^169\\.254\\./ {print $4; exit}' \
    <<<"${address_lines}")
  [[ -n ${cidr} ]] ||
    die "Pinned routed mode cannot start: ${interface} has no IPv4 address."
  UPSTREAM_IPV4=${cidr%/*}
  UPSTREAM_SUBNET=$(cidr_network "${cidr}") ||
    die "Pinned routed mode cannot start: ${interface} has an invalid IPv4 address."
  if cidrs_overlap "${AP_SUBNET}" "${UPSTREAM_SUBNET}"; then
    die "Pinned routed mode cannot start: ${AP_SUBNET} overlaps ${interface}."
  fi

  route_lines=$(ip -4 route show dev "${interface}" 2>/dev/null || true)
  while IFS= read -r route; do
    [[ -n ${route} ]] || continue
    destination=${route%% *}
    if [[ ${destination} == "default" ]] ||
      cidr_network "${destination}" >/dev/null 2>&1; then
      useful_route=1
    fi
  done <<<"${route_lines}"
  ((useful_route == 1)) ||
    die "Pinned routed mode cannot start: no usable route is associated with ${interface}."
  UPSTREAM_ROUTE_LINES=${route_lines}

  UPSTREAM_GATEWAY=""
  default_route=$(ip -4 route show default dev "${interface}" 2>/dev/null |
    head -n 1)
  if [[ -n ${default_route} ]]; then
    UPSTREAM_GATEWAY=$(awk '
      {for (i=1; i<=NF; i++) if ($i == "via") {print $(i+1); exit}}
    ' <<<"${default_route}")
    if [[ -n ${UPSTREAM_GATEWAY} ]] &&
      ! ipv4_to_int "${UPSTREAM_GATEWAY}" >/dev/null 2>&1; then
      die "Pinned routed mode cannot start: ${interface} has an invalid gateway."
    fi
  fi
  collect_upstream_dns
}

validate_subnet_overlaps() {
  local lines line interface cidr
  if ! lines=$(ip -o -4 address show up scope global 2>/dev/null); then
    die "could not inspect active IPv4 subnets"
  fi
  while IFS= read -r line; do
    [[ -n ${line} ]] || continue
    interface=$(awk '{print $2}' <<<"${line}")
    interface=${interface%%@*}
    cidr=$(awk '$3 == "inet" {print $4; exit}' <<<"${line}")
    [[ -n ${interface} && -n ${cidr} ]] || continue
    [[ ${interface} == "${WIPI_INTERFACE}" ]] && continue
    if [[ -n ${WIPI_UPSTREAM_INTERFACE} &&
      ${interface} == "${WIPI_UPSTREAM_INTERFACE}" ]]; then
      continue
    fi
    if cidrs_overlap "${AP_SUBNET}" "${cidr}"; then
      die "AP subnet ${AP_SUBNET} overlaps ${cidr} on ${interface}"
    fi
  done <<<"${lines}"
}

validate_hardware() {
  if [[ ${WIPI_SKIP_HARDWARE_VALIDATION:-0} == "1" ]]; then
    return
  fi

  ip link show dev "${WIPI_INTERFACE}" >/dev/null 2>&1 ||
    die "interface '${WIPI_INTERFACE}' does not exist"
  iw dev "${WIPI_INTERFACE}" info >/dev/null 2>&1 ||
    die "'${WIPI_INTERFACE}' is not a wireless interface"

  local phy_index phy_info channel_line
  phy_index=$(iw dev "${WIPI_INTERFACE}" info |
    awk '$1 == "wiphy" { print $2; exit }')
  [[ ${phy_index} =~ ^[0-9]+$ ]] ||
    die "could not determine wireless capabilities for '${WIPI_INTERFACE}'"
  phy_info=$(iw phy "phy${phy_index}" info)
  grep -Eq '^[[:space:]]*\*[[:space:]]+AP([[:space:]]|$)' <<<"${phy_info}" ||
    die "'${WIPI_INTERFACE}' does not support AP mode"

  channel_line=$(awk -v channel="[${WIPI_CHANNEL}]" \
    'index($0, channel) { print; exit }' <<<"${phy_info}")
  [[ -n ${channel_line} ]] ||
    die "'${WIPI_INTERFACE}' does not support channel ${WIPI_CHANNEL}"
  if grep -Eiq '\((disabled|no IR|radar detection)\)' <<<"${channel_line}"; then
    die "channel ${WIPI_CHANNEL} cannot be used for an AP on '${WIPI_INTERFACE}'"
  fi

  if [[ -n ${WIPI_UPSTREAM_INTERFACE} ]]; then
    validate_pinned_upstream
  fi
  validate_subnet_overlaps
}

validate_settings() {
  validate_logical_settings
  configure_country
  validate_hardware
}

next_option_value() {
  local option=$1
  local value=${2:-}
  [[ -n ${value} ]] || die "${option} requires a value"
  printf '%s\n' "${value}"
}

parse_configuration_options() {
  OPTION_COUNT=0
  while (($#)); do
    case $1 in
      --interface)
        WIPI_INTERFACE=$(next_option_value "$1" "${2:-}")
        shift 2
        ;;
      --ssid)
        WIPI_SSID=$(next_option_value "$1" "${2:-}")
        shift 2
        ;;
      --password)
        WIPI_PASSWORD=$(next_option_value "$1" "${2:-}")
        shift 2
        ;;
      --address)
        WIPI_ADDRESS=$(next_option_value "$1" "${2:-}")
        shift 2
        ;;
      --hostname)
        WIPI_HOSTNAME=$(next_option_value "$1" "${2:-}")
        shift 2
        ;;
      --country)
        WIPI_COUNTRY=$(next_option_value "$1" "${2:-}")
        shift 2
        ;;
      --band)
        WIPI_BAND=$(next_option_value "$1" "${2:-}")
        BAND_WAS_OVERRIDDEN=1
        shift 2
        ;;
      --channel)
        WIPI_CHANNEL=$(next_option_value "$1" "${2:-}")
        CHANNEL_WAS_OVERRIDDEN=1
        shift 2
        ;;
      --mode)
        WIPI_MODE=$(next_option_value "$1" "${2:-}")
        shift 2
        ;;
      --upstream-interface)
        (($# >= 2)) || die "$1 requires a value"
        UPSTREAM_WAS_OVERRIDDEN=1
        if [[ $2 == "auto" || $2 == "none" ]]; then
          WIPI_UPSTREAM_INTERFACE=""
        else
          WIPI_UPSTREAM_INTERFACE=$2
        fi
        shift 2
        ;;
      -h|--help)
        show_configuration_help
        exit 0
        ;;
      *)
        die "unknown configuration option '$1'"
        ;;
    esac
    ((OPTION_COUNT += 1))
  done
}

prompt_value() {
  local prompt=$1 default=$2
  local response
  read -r -p "${prompt} [${default}]: " response
  printf '%s\n' "${response:-${default}}"
}

interactive_configuration() {
  [[ -t 0 ]] || return 0

  WIPI_MODE=$(prompt_value "Mode (isolated or routed)" "${WIPI_MODE}")
  WIPI_INTERFACE=$(prompt_value "AP interface" "${WIPI_INTERFACE}")
  WIPI_SSID=$(prompt_value "SSID" "${WIPI_SSID}")
  WIPI_ADDRESS=$(prompt_value "AP address (/24)" "${WIPI_ADDRESS}")
  WIPI_HOSTNAME=$(prompt_value "Local hostname" "${WIPI_HOSTNAME}")
  WIPI_COUNTRY=$(prompt_value "Country code" "${WIPI_COUNTRY}")
  WIPI_BAND=$(prompt_value "Band (2.4 or 5)" "${WIPI_BAND}")
  WIPI_CHANNEL=$(prompt_value "Channel" "${WIPI_CHANNEL}")
  if [[ ${WIPI_MODE} == "routed" ]]; then
    WIPI_UPSTREAM_INTERFACE=$(
      prompt_value "Pinned upstream interface (blank for default route)" \
        "${WIPI_UPSTREAM_INTERFACE}"
    )
  else
    WIPI_UPSTREAM_INTERFACE=""
  fi

  local password_response
  read -r -s -p "New WPA2 password (blank to keep current): " password_response
  printf '\n'
  [[ -z ${password_response} ]] || WIPI_PASSWORD=${password_response}
}

prepare_configuration() {
  local allow_generate=$1
  shift

  capture_environment_overrides
  BAND_WAS_OVERRIDDEN=0
  CHANNEL_WAS_OVERRIDDEN=0
  UPSTREAM_WAS_OVERRIDDEN=0
  CONFIG_MIGRATED=0
  set_defaults
  load_config
  migrate_old_default_address
  apply_environment_overrides
  parse_configuration_options "$@"
  if ((BAND_WAS_OVERRIDDEN == 1 && CHANNEL_WAS_OVERRIDDEN == 0)); then
    case $(printf '%s' "${WIPI_BAND}" | tr '[:upper:]' '[:lower:]') in
      5|5ghz|a) WIPI_CHANNEL="36" ;;
      2.4|2.4ghz|bg) WIPI_CHANNEL="6" ;;
    esac
  fi
  if [[ ${allow_generate} == "yes" && -z ${WIPI_PASSWORD} ]]; then
    WIPI_PASSWORD=$(generate_password)
  fi
}

connection_exists_named() {
  nmcli --terse --fields NAME connection show 2>/dev/null |
    grep -Fxq "$1"
}

connection_exists() {
  connection_exists_named "${CONNECTION_NAME}"
}

profile_value() {
  nmcli --escape no -g "$1" connection show "${CONNECTION_NAME}" 2>/dev/null ||
    true
}

install_apt_packages() {
  local -a packages=("$@")
  ((${#packages[@]})) || return 0
  command_exists apt-get ||
    die "missing required tools and apt-get is unavailable"

  if ((APT_UPDATED == 0)); then
    log "updating package lists"
    apt-get update
    APT_UPDATED=1
  fi
  log "installing missing dependencies: ${packages[*]}"
  DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}"
}

install_dependencies() {
  local -a packages=()
  command_exists nmcli || packages+=(network-manager)
  command_exists iw || packages+=(iw)
  command_exists rfkill || packages+=(rfkill)
  command_exists ip || packages+=(iproute2)
  # dnsmasq-base supplies the binary without enabling a system-wide daemon.
  command_exists dnsmasq || packages+=(dnsmasq-base)
  command_exists nft || packages+=(nftables)
  if ((${#packages[@]} > 0)); then
    install_apt_packages "${packages[@]}"
  fi

  command_exists systemctl || die "systemd is required"
  command_exists sysctl || die "sysctl is required"
}

configure_country() {
  if command_exists iw; then
    iw reg set "${WIPI_COUNTRY}" ||
      warn "could not apply regulatory country ${WIPI_COUNTRY}"
  fi
}

configure_profile() {
  local created=0
  local profile_type=""
  if connection_exists; then
    profile_type=$(profile_value connection.type)
    if [[ ${profile_type} != "802-11-wireless" &&
      ${profile_type} != "wifi" ]]; then
      warn "recreating incompatible '${CONNECTION_NAME}' profile"
      nmcli connection delete "${CONNECTION_NAME}" >/dev/null
    fi
  fi

  if ! connection_exists; then
    log "creating NetworkManager profile '${CONNECTION_NAME}'"
    nmcli connection add \
      type wifi \
      ifname "${WIPI_INTERFACE}" \
      con-name "${CONNECTION_NAME}" \
      ssid "${WIPI_SSID}" >/dev/null
    created=1
  else
    log "updating NetworkManager profile '${CONNECTION_NAME}' in place"
  fi

  if ! nmcli connection modify "${CONNECTION_NAME}" \
    connection.id "${CONNECTION_NAME}" \
    connection.interface-name "${WIPI_INTERFACE}" \
    connection.autoconnect yes \
    connection.autoconnect-priority 100 \
    802-11-wireless.mode ap \
    802-11-wireless.ssid "${WIPI_SSID}" \
    802-11-wireless.band "${NM_BAND}" \
    802-11-wireless.channel "${WIPI_CHANNEL}" \
    802-11-wireless.cloned-mac-address permanent \
    802-11-wireless.powersave 2 \
    wifi-sec.key-mgmt wpa-psk \
    wifi-sec.proto rsn \
    wifi-sec.pairwise ccmp \
    wifi-sec.group ccmp \
    wifi-sec.pmf 1 \
    wifi-sec.psk "${WIPI_PASSWORD}" \
    ipv6.method disabled; then
    if ((created)); then
      nmcli connection delete "${CONNECTION_NAME}" >/dev/null 2>&1 || true
    fi
    die "could not configure the NetworkManager profile"
  fi

  if [[ ${WIPI_MODE} == "routed" &&
    -z ${WIPI_UPSTREAM_INTERFACE} ]]; then
    nmcli connection modify "${CONNECTION_NAME}" \
      ipv4.method shared \
      ipv4.addresses "${WIPI_ADDRESS}" \
      ipv4.gateway "" \
      ipv4.never-default no \
      ipv4.ignore-auto-dns no
  else
    nmcli connection modify "${CONNECTION_NAME}" \
      ipv4.method manual \
      ipv4.addresses "${WIPI_ADDRESS}" \
      ipv4.gateway "" \
      ipv4.never-default yes \
      ipv4.ignore-auto-dns yes
  fi

  if nmcli --fields 802-11-wireless.channel-width \
    connection show "${CONNECTION_NAME}" >/dev/null 2>&1; then
    nmcli connection modify "${CONNECTION_NAME}" \
      802-11-wireless.channel-width 20
  fi
}

write_systemd_unit() {
  install -d -m 755 "$(dirname "${UNIT_FILE}")"
  local temporary dns_temporary
  temporary=$(mktemp "${UNIT_FILE}.tmp.XXXXXX")
  cat >"${temporary}" <<EOF
[Unit]
Description=WiPi managed Raspberry Pi access point
Requires=NetworkManager.service
After=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=${SYSTEMD_COMMAND} _service-start
ExecStop=${SYSTEMD_COMMAND} _service-stop
TimeoutStartSec=45
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
EOF
  chmod 644 "${temporary}"
  mv -f "${temporary}" "${UNIT_FILE}"

  dns_temporary=$(mktemp "${DNS_UNIT_FILE}.tmp.XXXXXX")
  cat >"${dns_temporary}" <<'EOF'
[Unit]
Description=WiPi dedicated DHCP and DNS
PartOf=wipi.service
After=NetworkManager.service

[Service]
Type=simple
ExecStartPre=/usr/bin/test -r /run/wipi/dnsmasq.conf
ExecStart=/usr/sbin/dnsmasq --no-daemon --conf-file=/run/wipi/dnsmasq.conf --pid-file=/run/wipi/dnsmasq.pid
Restart=on-failure
RestartSec=2
EOF
  chmod 644 "${dns_temporary}"
  mv -f "${dns_temporary}" "${DNS_UNIT_FILE}"
}

write_routing_table_file() {
  install -d -m 755 "$(dirname "${ROUTING_TABLE_FILE}")"
  local temporary
  temporary=$(mktemp "${ROUTING_TABLE_FILE}.tmp.XXXXXX")
  printf '%s %s\n' "${ROUTING_TABLE_ID}" "${ROUTING_TABLE_NAME}" \
    >"${temporary}"
