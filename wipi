  cat <<EOF
WiPi ${WIPI_VERSION}
Usage: sudo wipi COMMAND [OPTIONS]
Default network: 10.10.0.1/24 (DHCP 10.10.0.10-10.10.0.100)

Commands:
  install [OPTIONS]            Install, configure, and start WiPi
  configure [OPTIONS]          Update saved configuration
  start                        Start the access point
  stop                         Stop the access point
  restart                      Restart the access point
  status                       Show concise AP and mode state
  mode isolated               Select management-only mode
  mode routed --upstream-interface auto|NAME
                               Select automatic or pinned routed mode
  credentials                  Explicitly display the SSID and password
  diagnose                     Show concise AP troubleshooting information
  uninstall [--keep-config]    Remove only WiPi-owned resources
  help                         Show this help

Examples:
  sudo wipi install --mode isolated
  sudo wipi configure --ssid management-ap --interface wlan0
  sudo wipi mode routed --upstream-interface auto
  sudo wipi mode routed --upstream-interface eth0
EOF
}

main() {
  local command=${1:-help}
  (($# == 0)) || shift
  case ${command} in
    install)
      install_wipi "$@"
      ;;
    configure)
      configure_wipi "$@"
      ;;
    start)
      require_no_arguments "${command}" "$@"
      require_root
      start_access_point
      ;;
    stop)
      require_no_arguments "${command}" "$@"
      require_root
      stop_access_point
      ;;
    restart)
      require_no_arguments "${command}" "$@"
      require_root
      restart_access_point
      ;;
    status)
      require_no_arguments "${command}" "$@"
      show_status
      ;;
    mode)
      require_root
      set_mode "$@"
      ;;
    credentials)
      require_no_arguments "${command}" "$@"
      show_credentials
      ;;
    diagnose)
      require_no_arguments "${command}" "$@"
      show_diagnostics
      ;;
    uninstall)
      uninstall_wipi "$@"
      ;;
    help|-h|--help)
      require_no_arguments "${command}" "$@"
      show_help
      ;;
    _service-start)
      require_no_arguments "${command}" "$@"
      service_start
      ;;
    _service-stop)
      require_no_arguments "${command}" "$@"
      service_stop
      ;;
    _network-changed)
      network_changed "$@"
      ;;
    *)
      show_help >&2
      die "unknown command '${command}'"
      ;;
  esac
}

if [[ ${WIPI_SOURCE_ONLY:-0} != "1" ]]; then
  main "$@"
fi
