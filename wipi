  if [[ ${BASH_SOURCE[0]} == "${INSTALLED_COMMAND}" ]]; then
    return
  fi
  install -d -m 755 "$(dirname "${INSTALLED_COMMAND}")"
  install -m 755 "${BASH_SOURCE[0]}" "${INSTALLED_COMMAND}"
}

dhcp_values() {
  local address=${WIPI_ADDRESS%/*}
  local first second third host
  IFS=. read -r first second third host <<<"${address}"
  AP_IPV4=${address}
  AP_SUBNET=$(cidr_network "${WIPI_ADDRESS}")
  AP_NETMASK="255.255.255.0"
  if ((10#${host} >= 10 && 10#${host} <= 100)); then
    DHCP_START="${first}.${second}.${third}.101"
    DHCP_END="${first}.${second}.${third}.200"
  else
    DHCP_START="${first}.${second}.${third}.10"
    DHCP_END="${first}.${second}.${third}.100"
  fi
}

render_dnsmasq_config() {
  dhcp_values
  cat <<EOF
interface=${WIPI_INTERFACE}
bind-interfaces
listen-address=${AP_IPV4}
except-interface=lo
dhcp-authoritative
dhcp-range=${DHCP_START},${DHCP_END},${AP_NETMASK},12h
dhcp-option=3,${AP_IPV4}
dhcp-option=6,${AP_IPV4}
address=/${WIPI_HOSTNAME}/${AP_IPV4}
no-resolv
no-hosts
domain-needed
bogus-priv
EOF
  if [[ ${WIPI_MODE} == "routed" &&
    -n ${WIPI_UPSTREAM_INTERFACE} &&
    -n ${PINNED_DNS_SERVERS} ]]; then
    local server
    while IFS= read -r server; do
      [[ -n ${server} ]] &&
        printf 'server=%s@%s\n' "${server}" "${WIPI_UPSTREAM_INTERFACE}"
    done <<<"${PINNED_DNS_SERVERS}"
  fi
}

write_dnsmasq_config() {
  install -d -m 700 "${RUN_DIR}"
  local temporary
  temporary=$(mktemp "${RUN_DIR}/dnsmasq.conf.tmp.XXXXXX")
  chmod 600 "${temporary}"
  render_dnsmasq_config >"${temporary}"
  mv -f "${temporary}" "${RUN_DIR}/dnsmasq.conf"
}

stop_dnsmasq() {
  if command_exists systemctl; then
    systemctl stop "${DNS_SERVICE_NAME}" >/dev/null 2>&1 || true
  fi
  rm -f "${RUN_DIR}/dnsmasq.pid" "${RUN_DIR}/dnsmasq.conf"
}

start_dnsmasq() {
  stop_dnsmasq
  write_dnsmasq_config
  if ! systemctl restart "${DNS_SERVICE_NAME}"; then
    warn "the supervised WiPi dnsmasq service failed to start"
    return 1
  fi
  if ! systemctl is-active --quiet "${DNS_SERVICE_NAME}"; then
    warn "the supervised WiPi dnsmasq service is not active"
    return 1
  fi
}

dnsmasq_is_running() {
  systemctl is-active --quiet "${DNS_SERVICE_NAME}" 2>/dev/null
}

render_firewall() {
  if [[ ${WIPI_MODE} == "isolated" ]]; then
    cat <<EOF
table inet wipi_filter {
  chain forward {
    type filter hook forward priority -150; policy accept;
    iifname "${WIPI_INTERFACE}" ip saddr ${AP_SUBNET} drop comment "wipi isolated outbound"
    oifname "${WIPI_INTERFACE}" ip daddr ${AP_SUBNET} drop comment "wipi isolated inbound"
    iifname "${WIPI_INTERFACE}" drop comment "wipi isolated spoof guard"
    oifname "${WIPI_INTERFACE}" drop comment "wipi isolated destination guard"
  }
}
EOF
  elif [[ -n ${WIPI_UPSTREAM_INTERFACE} ]]; then
    cat <<EOF
table inet wipi_filter {
  chain forward {
    type filter hook forward priority -150; policy accept;
    iifname "${WIPI_INTERFACE}" ip saddr ${AP_SUBNET} oifname "${WIPI_UPSTREAM_INTERFACE}" accept comment "wipi pinned outbound"
    iifname "${WIPI_INTERFACE}" ip saddr ${AP_SUBNET} drop comment "wipi pinned other egress drop"
    iifname "${WIPI_UPSTREAM_INTERFACE}" oifname "${WIPI_INTERFACE}" ip daddr ${AP_SUBNET} ct state established,related accept comment "wipi pinned replies"
    oifname "${WIPI_INTERFACE}" ip daddr ${AP_SUBNET} drop comment "wipi pinned inbound drop"
    iifname "${WIPI_INTERFACE}" drop comment "wipi pinned spoof guard"
    oifname "${WIPI_INTERFACE}" drop comment "wipi pinned destination guard"
  }
}
table ip wipi_nat {
  chain postrouting {
    type nat hook postrouting priority 100; policy accept;
    iifname "${WIPI_INTERFACE}" ip saddr ${AP_SUBNET} oifname "${WIPI_UPSTREAM_INTERFACE}" masquerade comment "wipi pinned nat"
  }
}
EOF
  fi
}

remove_firewall() {
  command_exists nft || return 0
  nft delete table inet wipi_filter >/dev/null 2>&1 || true
  nft delete table ip wipi_nat >/dev/null 2>&1 || true
}

apply_firewall() {
  remove_firewall
  if [[ ${WIPI_MODE} == "isolated" ||
    (${WIPI_MODE} == "routed" && -n ${WIPI_UPSTREAM_INTERFACE}) ]]; then
    if ! render_firewall | nft -f -; then
      warn "could not install the WiPi firewall policy"
      return 1
    fi
  fi
}

nft_filter_text() {
  nft list table inet wipi_filter 2>/dev/null || true
}

nft_nat_text() {
  nft list table ip wipi_nat 2>/dev/null || true
}

isolated_filter_is_active() {
  local rules
  rules=$(nft_filter_text)
  [[ ${rules} == *"iifname \"${WIPI_INTERFACE}\" ip saddr ${AP_SUBNET} drop"* ]] &&
    [[ ${rules} == *"oifname \"${WIPI_INTERFACE}\" ip daddr ${AP_SUBNET} drop"* ]]
}

pinned_filter_is_active() {
  local rules outbound_count accept_count
  rules=$(nft_filter_text)
  [[ ${rules} == *"iifname \"${WIPI_INTERFACE}\" ip saddr ${AP_SUBNET} oifname \"${WIPI_UPSTREAM_INTERFACE}\" accept"* ]] ||
    return 1
  [[ ${rules} == *"iifname \"${WIPI_INTERFACE}\" ip saddr ${AP_SUBNET} drop"* ]] ||
    return 1
  [[ ${rules} == *"iifname \"${WIPI_UPSTREAM_INTERFACE}\" oifname \"${WIPI_INTERFACE}\" ip daddr ${AP_SUBNET} ct state established,related accept"* ]] ||
    return 1
  [[ ${rules} == *"oifname \"${WIPI_INTERFACE}\" ip daddr ${AP_SUBNET} drop"* ]] ||
    return 1
  outbound_count=$(grep -Fc 'comment "wipi pinned outbound"' <<<"${rules}" ||
    true)
  accept_count=$(grep -c ' accept comment' <<<"${rules}" || true)
  [[ ${outbound_count} == "1" && ${accept_count} == "2" ]]
}

pinned_nat_is_active() {
  local rules masquerade_count all_rules ap_masquerade_count
  rules=$(nft_nat_text)
  [[ ${rules} == *"iifname \"${WIPI_INTERFACE}\" ip saddr ${AP_SUBNET} oifname \"${WIPI_UPSTREAM_INTERFACE}\" masquerade"* ]] ||
    return 1
  masquerade_count=$(grep -c ' masquerade' <<<"${rules}" || true)
  [[ ${masquerade_count} == "1" ]] || return 1
  all_rules=$(nft list ruleset 2>/dev/null || true)
  ap_masquerade_count=$(grep -F "${AP_SUBNET}" <<<"${all_rules}" |
    grep -c ' masquerade' || true)
  [[ ${ap_masquerade_count} == "1" ]]
}

wipi_nat_is_absent() {
  [[ -z $(nft_nat_text) ]]
}

ap_nat_is_absent() {
  local rules
  rules=$(nft list ruleset 2>/dev/null || true)
  ! grep -F "${AP_SUBNET}" <<<"${rules}" | grep -q ' masquerade'
}

automatic_nat_runtime_state() {
  local rules
  rules=$(nft list ruleset 2>/dev/null || true)
  if grep -F "${AP_SUBNET}" <<<"${rules}" | grep -q 'masquerade'; then
    printf 'verified\n'
  else
    printf 'unverified\n'
  fi
}

dnsmasq_configuration_is_safe() {
  [[ -r ${RUN_DIR}/dnsmasq.conf ]] || return 1
  local configuration server expected_count=0 actual_count
  configuration=$(<"${RUN_DIR}/dnsmasq.conf")
  grep -Fxq 'no-resolv' <<<"${configuration}" || return 1
  grep -Fxq "address=/${WIPI_HOSTNAME}/${AP_IPV4}" \
    <<<"${configuration}" || return 1
  if [[ ${WIPI_MODE} == "isolated" ]]; then
    if grep -q '^server=' <<<"${configuration}"; then
      return 1
    fi
    return 0
  fi
  while IFS= read -r server; do
    [[ -n ${server} ]] || continue
    grep -Fxq "server=${server}@${WIPI_UPSTREAM_INTERFACE}" \
      <<<"${configuration}" || return 1
    expected_count=$((expected_count + 1))
  done <<<"${PINNED_DNS_SERVERS}"
  actual_count=$(grep -c '^server=' <<<"${configuration}" || true)
  [[ ${actual_count} == "${expected_count}" ]]
}

policy_rule_text() {
  ip -4 rule show 2>/dev/null |
    awk -v priority="${POLICY_RULE_PRIORITY}:" \
      '$1 == priority {print}'
}

routing_table_is_owned() {
  [[ -e ${STATE_DIR}/routing-table-4242.owned ]]
}

claim_routing_table() {
  routing_table_is_owned && return 0
  local existing_routes existing_rules
  existing_routes=$(ip -4 route show table "${ROUTING_TABLE_ID}" \
    2>/dev/null || true)
  existing_rules=$(ip -4 rule show 2>/dev/null |
    grep -E "lookup (${ROUTING_TABLE_ID}|${ROUTING_TABLE_NAME})([[:space:]]|$)" ||
    true)
  [[ -z ${existing_routes} && -z ${existing_rules} ]] ||
    die "Pinned routed mode cannot start: routing table ${ROUTING_TABLE_ID} is already in use."
  install -d -m 700 "${STATE_DIR}"
  : >"${STATE_DIR}/routing-table-4242.owned"
  chmod 600 "${STATE_DIR}/routing-table-4242.owned"
}

remove_policy_routing() {
  command_exists ip || return 0
  routing_table_is_owned || return 0
  local rule
  while :; do
    rule=$(policy_rule_text)
    [[ ${rule} == *"lookup ${ROUTING_TABLE_ID}"* ||
      ${rule} == *"lookup ${ROUTING_TABLE_NAME}"* ]] || break
    ip -4 rule delete priority "${POLICY_RULE_PRIORITY}" \
      table "${ROUTING_TABLE_ID}" >/dev/null 2>&1 || break
  done
  ip -4 route flush table "${ROUTING_TABLE_ID}" >/dev/null 2>&1 || true
}

route_field() {
  local line=$1 field=$2
  awk -v wanted="${field}" '
    {for (i=1; i<=NF; i++) if ($i == wanted) {print $(i+1); exit}}
  ' <<<"${line}"
}

normalize_route_destination() {
  local destination=$1
  if [[ ${destination} == "default" ]]; then
    printf 'default\n'
  elif [[ ${destination} == */* ]]; then
    cidr_network "${destination}"
  elif ipv4_to_int "${destination}" >/dev/null 2>&1; then
    printf '%s/32\n' "${destination}"
  else
    return 1
  fi
}

apply_policy_routing() {
  local existing route destination normalized gateway
  local default_added=0
  remove_policy_routing
  existing=$(policy_rule_text)
  [[ -z ${existing} ]] ||
    die "Pinned routed mode cannot start: policy-rule priority ${POLICY_RULE_PRIORITY} is already in use."

  ip -4 route replace table "${ROUTING_TABLE_ID}" \
    "${AP_SUBNET}" dev "${WIPI_INTERFACE}" scope link src "${AP_IPV4}" ||
    die "Pinned routed mode cannot start: could not add the AP-local route."
  ip -4 route replace table "${ROUTING_TABLE_ID}" \
    "${UPSTREAM_SUBNET}" dev "${WIPI_UPSTREAM_INTERFACE}" \
    scope link src "${UPSTREAM_IPV4}" ||
    die "Pinned routed mode cannot start: could not add the upstream connected route."

  while IFS= read -r route; do
    [[ -n ${route} ]] || continue
    destination=${route%% *}
    normalized=$(normalize_route_destination "${destination}" 2>/dev/null ||
      true)
    [[ -n ${normalized} ]] || continue
    if [[ ${normalized} == "default" ]]; then
      ((default_added == 0)) || continue
      default_added=1
    fi
    if [[ ${normalized} != "default" ]] &&
      cidrs_overlap "${AP_SUBNET}" "${normalized}"; then
      continue
    fi
    gateway=$(route_field "${route}" via)
    if [[ -n ${gateway} ]]; then
      ipv4_to_int "${gateway}" >/dev/null 2>&1 || continue
      ip -4 route replace table "${ROUTING_TABLE_ID}" \
        "${normalized}" via "${gateway}" dev "${WIPI_UPSTREAM_INTERFACE}" \
        src "${UPSTREAM_IPV4}" ||
        die "Pinned routed mode cannot start: could not copy route ${normalized}."
    else
      ip -4 route replace table "${ROUTING_TABLE_ID}" \
        "${normalized}" dev "${WIPI_UPSTREAM_INTERFACE}" \
        src "${UPSTREAM_IPV4}" ||
        die "Pinned routed mode cannot start: could not copy route ${normalized}."
    fi
  done <<<"${UPSTREAM_ROUTE_LINES}"

  ip -4 rule add priority "${POLICY_RULE_PRIORITY}" \
    iif "${WIPI_INTERFACE}" from "${AP_SUBNET}" \
    lookup "${ROUTING_TABLE_ID}" ||
    die "Pinned routed mode cannot start: could not install the source policy rule."
}

policy_rule_is_active() {
  local rule matching_count
  rule=$(policy_rule_text)
  [[ ${rule} == *"from ${AP_SUBNET}"* ]] || return 1
  [[ ${rule} == *"iif ${WIPI_INTERFACE}"* ]] || return 1
  [[ ${rule} == *"lookup ${ROUTING_TABLE_ID}"* ||
    ${rule} == *"lookup ${ROUTING_TABLE_NAME}"* ]] || return 1
  matching_count=$(ip -4 rule show 2>/dev/null |
    grep -Ec "lookup (${ROUTING_TABLE_ID}|${ROUTING_TABLE_NAME})([[:space:]]|$)" ||
    true)
  [[ ${matching_count} == "1" ]]
}

route_verification_destination() {
  if [[ -n ${UPSTREAM_GATEWAY} ]]; then
    printf '%s\n' "${UPSTREAM_GATEWAY}"
    return
  fi
  if [[ -n ${PINNED_DNS_SERVERS} ]]; then
    printf '%s\n' "${PINNED_DNS_SERVERS%%$'\n'*}"
    return
  fi
  local network_int
  network_int=$(ipv4_to_int "${UPSTREAM_SUBNET%/*}")
  int_to_ipv4 "$((network_int + 1))"
}

routing_table_is_valid() {
  local table route_test destination line device
  table=$(ip -4 route show table "${ROUTING_TABLE_ID}" 2>/dev/null || true)
  grep -Fq "${AP_SUBNET} dev ${WIPI_INTERFACE}" <<<"${table}" || return 1
  grep -Fq "${UPSTREAM_SUBNET} dev ${WIPI_UPSTREAM_INTERFACE}" \
    <<<"${table}" || return 1
  while IFS= read -r line; do
    [[ -n ${line} ]] || continue
    device=$(route_field "${line}" dev)
    [[ -z ${device} || ${device} == "${WIPI_INTERFACE}" ||
      ${device} == "${WIPI_UPSTREAM_INTERFACE}" ]] || return 1
  done <<<"${table}"
  destination=$(route_verification_destination)
  route_test=$(ip -4 route get "${destination}" from "${DHCP_START}" \
    iif "${WIPI_INTERFACE}" 2>/dev/null || true)
  [[ ${route_test} == *"dev ${WIPI_UPSTREAM_INTERFACE}"* ]] || return 1
  [[ ${route_test} == *"table ${ROUTING_TABLE_ID}"* ||
    ${route_test} == *"table ${ROUTING_TABLE_NAME}"* ]]
}

pinned_dns_routes_are_valid() {
  local server route_test
  while IFS= read -r server; do
    [[ -n ${server} ]] || continue
    route_test=$(ip -4 route get "${server}" from "${DHCP_START}" \
      iif "${WIPI_INTERFACE}" 2>/dev/null || true)
    [[ ${route_test} == *"dev ${WIPI_UPSTREAM_INTERFACE}"* ]] || return 1
    [[ ${route_test} == *"table ${ROUTING_TABLE_ID}"* ||
      ${route_test} == *"table ${ROUTING_TABLE_NAME}"* ]] || return 1
  done <<<"${PINNED_DNS_SERVERS}"
}

read_ip_forwarding() {
  sysctl -n net.ipv4.ip_forward
}

enable_ip_forwarding() {
  install -d -m 700 "${STATE_DIR}"
  local previous
  previous=$(read_ip_forwarding)
  if [[ ! -e ${STATE_DIR}/ip_forward.previous ]]; then
    printf '%s\n' "${previous}" >"${STATE_DIR}/ip_forward.previous"
    chmod 600 "${STATE_DIR}/ip_forward.previous"
  fi
  if [[ ${previous} != "1" ]]; then
    sysctl -q -w net.ipv4.ip_forward=1
    : >"${STATE_DIR}/ip_forward.changed"
    chmod 600 "${STATE_DIR}/ip_forward.changed"
  fi
}

restore_ip_forwarding() {
  local previous_file="${STATE_DIR}/ip_forward.previous"
  local changed_file="${STATE_DIR}/ip_forward.changed"
  if [[ -r ${previous_file} && -e ${changed_file} ]]; then
    local previous current
    previous=$(<"${previous_file}")
    current=$(read_ip_forwarding)
    if [[ ${previous} =~ ^[01]$ && ${current} == "1" ]]; then
      sysctl -q -w "net.ipv4.ip_forward=${previous}"
    fi
  fi
  rm -f "${previous_file}" "${changed_file}"
}

profile_is_active() {
  nmcli --terse --fields NAME connection show --active 2>/dev/null |
    grep -Fxq "${CONNECTION_NAME}"
}

activate_profile() {
  rfkill unblock wifi 2>/dev/null || true
  nmcli radio wifi on || return 1
  nmcli device set "${WIPI_INTERFACE}" managed yes || return 1
  nmcli connection up "${CONNECTION_NAME}" || return 1
  iw dev "${WIPI_INTERFACE}" set power_save off 2>/dev/null || true
}

rollback_runtime() {
  stop_dnsmasq
  nmcli connection down "${CONNECTION_NAME}" >/dev/null 2>&1 || true
  remove_firewall
  remove_policy_routing
  restore_ip_forwarding
}

startup_exit() {
  local status=$?
  trap - EXIT ERR
  rollback_runtime || true
  warn "startup failed; WiPi-owned firewall, NAT, policy-routing, and DNS state were rolled back"
  return "${status}"
}

startup_command_error() {
  local line=$1 command=$2
  warn "startup command failed at line ${line}: ${command}"
  return 1
}

verify_runtime_for_mode() {
  profile_is_active || {
    warn "runtime verification failed: the WiPi profile is inactive"
    return 1
  }
  if [[ ${WIPI_MODE} == "isolated" ]]; then
    isolated_filter_is_active || {
      warn "runtime verification failed: the isolated forwarding filter is missing"
      return 1
    }
    if ! { wipi_nat_is_absent && ap_nat_is_absent; }; then
      warn "runtime verification failed: isolated mode has unexpected WiPi NAT"
      return 1
    fi
    [[ -z $(policy_rule_text) ]] || {
      warn "runtime verification failed: isolated mode has stale policy routing"
      return 1
    }
    if ! { dnsmasq_is_running && dnsmasq_configuration_is_safe; }; then
      warn "runtime verification failed: isolated DHCP/DNS is unhealthy"
      return 1
    fi
  elif [[ -z ${WIPI_UPSTREAM_INTERFACE} ]]; then
    [[ -z $(policy_rule_text) ]] || {
      warn "runtime verification failed: automatic mode has stale policy routing"
      return 1
    }
    wipi_nat_is_absent || {
      warn "runtime verification failed: automatic mode has stale WiPi NAT"
      return 1
    }
    [[ $(profile_value ipv4.method) == "shared" ]] || {
      warn "runtime verification failed: NetworkManager sharing is not configured"
      return 1
    }
  else
    policy_rule_is_active || {
      warn "runtime verification failed: the pinned source rule is missing"
      return 1
    }
    routing_table_is_valid || {
      warn "runtime verification failed: routing table ${ROUTING_TABLE_ID} is invalid"
      return 1
    }
    pinned_filter_is_active || {
      warn "runtime verification failed: the pinned forwarding filter is incomplete"
      return 1
    }
    pinned_nat_is_active || {
      warn "runtime verification failed: the pinned NAT rule is missing or incorrect"
      return 1
    }
    if ! { dnsmasq_is_running && dnsmasq_configuration_is_safe; }; then
      warn "runtime verification failed: pinned DHCP/DNS is unhealthy"
      return 1
    fi
  fi
}

service_start() {
  require_root
  command_exists nmcli || die "NetworkManager is not installed"
  connection_exists || die "NetworkManager profile '${CONNECTION_NAME}' is missing"
  set_defaults
  load_config
  migrate_old_default_address
  validate_logical_settings
  configure_country
  validate_hardware
  dhcp_values
  if ((CONFIG_MIGRATED == 1)); then
    configure_profile
    write_config
  fi
  if [[ ${WIPI_MODE} == "routed" &&
    -n ${WIPI_UPSTREAM_INTERFACE} ]]; then
    claim_routing_table
  fi

  trap 'startup_command_error "${LINENO}" "${BASH_COMMAND}"' ERR
  trap startup_exit EXIT
  install -d -m 700 "${RUN_DIR}" "${STATE_DIR}"
  stop_dnsmasq
  nmcli connection down "${CONNECTION_NAME}" >/dev/null 2>&1 || true
  remove_firewall
  remove_policy_routing

  if [[ ${WIPI_MODE} == "routed" ]]; then
    enable_ip_forwarding
  else
    restore_ip_forwarding
  fi

  apply_firewall ||
    die "could not apply mode-specific WiPi nftables state"
  activate_profile ||
    die "could not activate the WiPi NetworkManager profile"

  if [[ ${WIPI_MODE} == "routed" &&
    -n ${WIPI_UPSTREAM_INTERFACE} ]]; then
    apply_policy_routing
  fi

  if [[ ${WIPI_MODE} == "isolated" ||
    (${WIPI_MODE} == "routed" && -n ${WIPI_UPSTREAM_INTERFACE}) ]]; then
    if [[ ${WIPI_MODE} == "routed" && -z ${PINNED_DNS_SERVERS} ]]; then
      warn "${WIPI_UPSTREAM_INTERFACE} has no usable NetworkManager DNS server; direct-IP routing remains available"
    fi
    if ! start_dnsmasq; then
      die "could not start the supervised WiPi DHCP/DNS service"
    fi
  fi
  verify_runtime_for_mode ||
    die "runtime verification rejected the requested WiPi mode"
  trap - EXIT ERR
}

service_stop() {
  require_root
  stop_dnsmasq
  if command_exists nmcli && connection_exists; then
    nmcli connection down "${CONNECTION_NAME}" >/dev/null 2>&1 || true
  fi
  remove_firewall
  remove_policy_routing
  restore_ip_forwarding
}

systemd_available() {
  command_exists systemctl && [[ -d $(root_path /run/systemd/system) ]]
}

start_access_point() {
  if systemd_available; then
    systemctl start "${SERVICE_NAME}"
  else
    service_start
  fi
}

stop_access_point() {
  if systemd_available; then
    systemctl stop "${SERVICE_NAME}"
  else
    service_stop
  fi
}

restart_access_point() {
  if systemd_available; then
    systemctl restart "${SERVICE_NAME}"
  else
    service_stop
    service_start
  fi
}

network_changed() {
  require_root
  local interface=${1:-}
  (($# == 2)) || return 0
  [[ ${interface} =~ ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,14}$ ]] || return 0
  [[ -r ${CONFIG_FILE} ]] || return 0
  set_defaults
  load_config
  migrate_old_default_address
  UPSTREAM_WAS_OVERRIDDEN=0
  validate_logical_settings
  if [[ ${WIPI_MODE} == "routed" &&
    -n ${WIPI_UPSTREAM_INTERFACE} &&
    ${interface} == "${WIPI_UPSTREAM_INTERFACE}" ]]; then
    systemctl --no-block try-restart "${SERVICE_NAME}"
  fi
}

remove_legacy_profile() {
  if connection_exists_named "${LEGACY_CONNECTION_NAME}"; then
    log "removing the obsolete WiPi profile '${LEGACY_CONNECTION_NAME}'"
    nmcli connection delete "${LEGACY_CONNECTION_NAME}" >/dev/null
  fi
}

INSTALL_TRANSACTION_BACKUP=""
INSTALL_HAD_PREVIOUS_CONFIG=0

rollback_install_transaction() {
  local status=$?
  trap - EXIT ERR
  set +e
  warn "installation activation failed; rolling back WiPi-owned runtime state"
  systemctl stop "${DNS_SERVICE_NAME}" >/dev/null 2>&1
  systemctl stop "${SERVICE_NAME}" >/dev/null 2>&1
  rollback_runtime
  if ((INSTALL_HAD_PREVIOUS_CONFIG == 1)) &&
    [[ -r ${INSTALL_TRANSACTION_BACKUP} ]]; then
    install -m 600 "${INSTALL_TRANSACTION_BACKUP}" "${CONFIG_FILE}"
    set_defaults
    load_config
    UPSTREAM_WAS_OVERRIDDEN=0
    validate_logical_settings
    configure_country
    (configure_profile) >/dev/null 2>&1 ||
      warn "the previous NetworkManager profile could not be fully restored"
    systemctl start "${SERVICE_NAME}" >/dev/null 2>&1 ||
      warn "the previous WiPi runtime could not be restarted"
  else
    rm -f "${CONFIG_FILE}"
    if connection_exists; then
      nmcli connection delete "${CONNECTION_NAME}" >/dev/null 2>&1
    fi
    rm -f "${UNIT_FILE}" "${DNS_UNIT_FILE}" "${ROUTING_TABLE_FILE}" \
      "${DISPATCHER_FILE}" "${INSTALLED_COMMAND}"
    rm -rf -- "${RUN_DIR}" "${STATE_DIR}"
    systemctl daemon-reload >/dev/null 2>&1
  fi
  rm -f "${INSTALL_TRANSACTION_BACKUP}"
  return "${status}"
}

install_wipi() {
  require_root
  require_linux
  install_dependencies
  systemctl enable --now NetworkManager >/dev/null
  prepare_configuration yes "$@"
  validate_settings

  install -d -m 700 "${RUN_DIR}"
  if [[ -r ${CONFIG_FILE} ]]; then
    INSTALL_HAD_PREVIOUS_CONFIG=1
    INSTALL_TRANSACTION_BACKUP=$(mktemp \
      "${RUN_DIR}/wipi.install.rollback.XXXXXX")
    install -m 600 "${CONFIG_FILE}" "${INSTALL_TRANSACTION_BACKUP}"
  fi
  trap rollback_install_transaction EXIT

  configure_profile
  write_config
  install_command
  write_systemd_unit
  write_routing_table_file
  write_network_dispatcher
  remove_legacy_profile

  systemctl daemon-reload
  systemctl enable "${SERVICE_NAME}" >/dev/null
  systemctl restart "${SERVICE_NAME}" ||
    die "the installed WiPi mode failed runtime verification"
  trap - EXIT
  rm -f "${INSTALL_TRANSACTION_BACKUP}"
  INSTALL_TRANSACTION_BACKUP=""

  log "access point installed in ${WIPI_MODE} mode"
  printf 'SSID:       %s\n' "${WIPI_SSID}"
  printf 'Password:   %s\n' "${WIPI_PASSWORD}"
  printf 'Interface:  %s\n' "${WIPI_INTERFACE}"
  printf 'Address:    %s\n' "${WIPI_ADDRESS}"
  printf 'Status:     sudo wipi status\n'
}

CONFIG_TRANSACTION_BACKUP=""

rollback_configuration_transaction() {
  local status=$?
  trap - EXIT ERR
  set +e
  warn "configuration activation failed; restoring the previous WiPi configuration"
  systemctl stop "${SERVICE_NAME}" >/dev/null 2>&1
  if [[ -r ${CONFIG_TRANSACTION_BACKUP} ]]; then
    install -m 600 "${CONFIG_TRANSACTION_BACKUP}" "${CONFIG_FILE}"
    set_defaults
    load_config
    UPSTREAM_WAS_OVERRIDDEN=0
    validate_logical_settings
    configure_country
    (configure_profile) >/dev/null 2>&1 ||
      warn "the previous NetworkManager profile could not be fully restored"
    systemctl start "${SERVICE_NAME}" >/dev/null 2>&1 ||
      warn "the previous WiPi runtime could not be restarted"
  fi
  rm -f "${CONFIG_TRANSACTION_BACKUP}"
  return "${status}"
}

configure_wipi() {
  require_root
  [[ -r ${CONFIG_FILE} ]] ||
    die "WiPi is not installed; run 'sudo wipi install' first"
  prepare_configuration no "$@"
  if ((OPTION_COUNT == 0 && ${#ENV_OVERRIDE_KEYS[@]} == 0)); then
    interactive_configuration
  fi
  validate_settings
  install -d -m 700 "${RUN_DIR}"
  CONFIG_TRANSACTION_BACKUP=$(mktemp "${RUN_DIR}/wipi.conf.rollback.XXXXXX")
  install -m 600 "${CONFIG_FILE}" "${CONFIG_TRANSACTION_BACKUP}"
  trap rollback_configuration_transaction EXIT

  systemctl stop "${SERVICE_NAME}" ||
    die "could not stop the previous WiPi mode before reconfiguration"
  configure_profile
  write_config
  systemctl start "${SERVICE_NAME}" ||
    die "the requested WiPi configuration could not be activated"
  trap - EXIT
  rm -f "${CONFIG_TRANSACTION_BACKUP}"
  CONFIG_TRANSACTION_BACKUP=""
  log "configuration updated"
}

set_mode() {
  local mode=${1:-}
  case ${mode} in
    isolated)
      (($# == 1)) ||
        die "usage: sudo wipi mode isolated"
      configure_wipi --mode isolated
      ;;
    routed)
      (($# == 3)) && [[ $2 == "--upstream-interface" ]] ||
        die "usage: sudo wipi mode routed --upstream-interface auto|INTERFACE"
      configure_wipi --mode routed --upstream-interface "$3"
      ;;
    *)
      die "usage: sudo wipi mode isolated | sudo wipi mode routed --upstream-interface auto|INTERFACE"
      ;;
  esac
}

client_count() {
  if ! command_exists iw; then
    printf 'unknown\n'
    return
  fi
  { iw dev "${WIPI_INTERFACE}" station dump 2>/dev/null || true; } |
    awk '/^Station / { count += 1 } END { print count + 0 }'
}

default_route_summary() {
  local route
  route=$(ip -4 route show default 2>/dev/null | head -n 1)
  [[ -n ${route} ]] || {
    printf 'none\n'
    return
  }
  local gateway device
  gateway=$(awk '{for (i=1; i<=NF; i++) if ($i=="via") print $(i+1)}' <<<"${route}")
  device=$(awk '{for (i=1; i<=NF; i++) if ($i=="dev") print $(i+1)}' <<<"${route}")
  if [[ -n ${gateway} ]]; then
    printf '%s via %s\n' "${gateway}" "${device:-unknown}"
  else
    printf 'direct via %s\n' "${device:-unknown}"
  fi
}

load_pinned_runtime_metadata() {
  UPSTREAM_IPV4=""
  UPSTREAM_SUBNET=""
  UPSTREAM_GATEWAY=""
  UPSTREAM_ROUTE_LINES=""
  PINNED_DNS_SERVERS=""
  local cidr
  cidr=$(ip -o -4 address show dev "${WIPI_UPSTREAM_INTERFACE}" \
    scope global 2>/dev/null |
    awk '$3 == "inet" && $4 !~ /^169\\.254\\./ {print $4; exit}')
  if [[ -n ${cidr} ]]; then
    UPSTREAM_IPV4=${cidr%/*}
    UPSTREAM_SUBNET=$(cidr_network "${cidr}" 2>/dev/null || true)
  fi
  UPSTREAM_ROUTE_LINES=$(ip -4 route show dev \
    "${WIPI_UPSTREAM_INTERFACE}" 2>/dev/null || true)
  UPSTREAM_GATEWAY=$(ip -4 route show default dev \
    "${WIPI_UPSTREAM_INTERFACE}" 2>/dev/null |
    awk '
      NR == 1 {
        for (i=1; i<=NF; i++) if ($i == "via") {print $(i+1); exit}
      }
    ')
  collect_upstream_dns
}

pinned_upstream_runtime_is_usable() {
  local link_output flags wireless_info
  link_output=$(ip -o link show dev "${WIPI_UPSTREAM_INTERFACE}" \
    2>/dev/null || true)
  [[ -n ${link_output} ]] || return 1
  flags=${link_output#*<}
  flags=${flags%%>*}
  [[ ,${flags}, == *,UP,* ]] || return 1
  local carrier_path="${WIPI_SYS_CLASS_NET_ROOT:-/sys/class/net}/${WIPI_UPSTREAM_INTERFACE}/carrier"
  if [[ -r ${carrier_path} && $(<"${carrier_path}") != "1" ]]; then
    return 1
  fi
  wireless_info=$(iw dev "${WIPI_UPSTREAM_INTERFACE}" info \
    2>/dev/null || true)
  grep -Eq '^[[:space:]]*type[[:space:]]+monitor([[:space:]]|$)' \
    <<<"${wireless_info}" && return 1
  [[ -n ${UPSTREAM_IPV4} && -n ${UPSTREAM_SUBNET} &&
    -n ${UPSTREAM_ROUTE_LINES} ]] || return 1
  ! cidrs_overlap "${AP_SUBNET}" "${UPSTREAM_SUBNET}"
}

status_value() {
  printf '%-26s %s\n' "$1:" "$2"
}

show_status() {
  require_root
  command_exists nmcli || die "NetworkManager is not installed"
  [[ -r ${CONFIG_FILE} ]] || die "WiPi is not installed"
  set_defaults
  load_config
  migrate_old_default_address
  validate_logical_settings
  dhcp_values

  local active_state="inactive"
  profile_is_active && active_state="active"
  local autostart="disabled"
  systemctl is-enabled "${SERVICE_NAME}" >/dev/null 2>&1 &&
    autostart="enabled"

  local dhcp
  dnsmasq_is_running && dhcp="active" || dhcp="inactive"

  printf 'WiPi status\n'
  status_value "Mode" "${WIPI_MODE}"
  status_value "AP interface" "${WIPI_INTERFACE}"
  status_value "AP state" "${active_state}"
  status_value "SSID" "${WIPI_SSID}"
  status_value "Band/channel" "${WIPI_BAND} GHz / ${WIPI_CHANNEL}"
  status_value "AP address" "${WIPI_ADDRESS}"
  status_value "AP subnet" "${AP_SUBNET}"
  status_value "DHCP range" "${DHCP_START}-${DHCP_END}"
  status_value "Local hostname" "${WIPI_HOSTNAME}"
  status_value "Connected clients" "$(client_count)"

  if [[ ${WIPI_MODE} == "isolated" ]]; then
    status_value "Routing behavior" "management only"
    status_value "DHCP" "${dhcp}"
    status_value "DNS mode" "local only"
    if isolated_filter_is_active; then
      status_value "Forwarding rule" "active"
    else
      status_value "Forwarding rule" "missing"
    fi
    if wipi_nat_is_absent && ap_nat_is_absent; then
      status_value "NAT" "disabled"
    else
      status_value "NAT" "unexpected"
    fi
    status_value "Upstream interface" "none"
  elif [[ -z ${WIPI_UPSTREAM_INTERFACE} ]]; then
    status_value "Routing behavior" "automatic"
    status_value "Upstream selection" "host routing table"
    status_value "Default route" "$(default_route_summary)"
    status_value "Egress pinning" "disabled"
    if [[ $(profile_value ipv4.method) == "shared" ]]; then
      status_value "NetworkManager sharing" "configured/${active_state}"
    else
      status_value "NetworkManager sharing" "not configured"
    fi
    status_value "NAT ownership" "NetworkManager"
    status_value "NAT runtime state" "$(automatic_nat_runtime_state)"
    status_value "DNS mode" "NetworkManager shared"
  else
    load_pinned_runtime_metadata
    local policy_state="missing" table_state="invalid"
    local filter_state="missing" nat_state="missing"
    local dns_state="unverified" other_egress="unverified"
    local egress_state="not enforced" dns_safe=0 upstream_usable=0
    pinned_upstream_runtime_is_usable && upstream_usable=1
    policy_rule_is_active && policy_state="active"
    if [[ ${upstream_usable} == "1" ]] && routing_table_is_valid; then
      table_state="valid"
    fi
    if pinned_filter_is_active; then
      filter_state="active"
      other_egress="blocked"
    fi
    pinned_nat_is_active && nat_state="${WIPI_UPSTREAM_INTERFACE} only"
    if dnsmasq_is_running && dnsmasq_configuration_is_safe &&
      pinned_dns_routes_are_valid; then
      dns_safe=1
      if [[ -n ${PINNED_DNS_SERVERS} ]]; then
        dns_state="${WIPI_UPSTREAM_INTERFACE}"
      else
        dns_state="none (unavailable)"
      fi
    fi
    if [[ ${policy_state} == "active" && ${table_state} == "valid" &&
      ${filter_state} == "active" &&
      ${nat_state} == "${WIPI_UPSTREAM_INTERFACE} only" &&
      ${other_egress} == "blocked" && ${dns_safe} == "1" &&
      ${upstream_usable} == "1" ]]; then
      egress_state="enforced"
    fi

    status_value "Routing behavior" "pinned"
    status_value "DHCP" "${dhcp}"
    status_value "Upstream interface" "${WIPI_UPSTREAM_INTERFACE}"
    status_value "Upstream IPv4 address" "${UPSTREAM_IPV4:-unavailable}"
    status_value "Upstream subnet" "${UPSTREAM_SUBNET:-unavailable}"
    status_value "Upstream gateway" "${UPSTREAM_GATEWAY:-none}"
    status_value "Policy rule" "${policy_state}"
    status_value "Routing table 4242" "${table_state}"
    status_value "Forwarding filter" "${filter_state}"
    status_value "NAT rule" "${nat_state}"
    status_value "DNS upstream" "${dns_state}"
    status_value "Other AP egress" "${other_egress}"
    status_value "Egress pinning" "${egress_state}"
  fi
  status_value "Autostart" "${autostart}"
}

redacted_config() {
  local key
  for key in "${CONFIG_KEYS[@]}"; do
    if [[ ${key} == "WIPI_PASSWORD" ]]; then
      printf '%s="<redacted>"\n' "${key}"
    else
      printf '%s="%s"\n' "${key}" "${!key}"
    fi
  done
}

show_diagnostics() {
  require_root
  command_exists nmcli || die "NetworkManager is not installed"
  [[ -r ${CONFIG_FILE} ]] || die "WiPi is not installed"
  set_defaults
  load_config
  migrate_old_default_address
  validate_logical_settings
  dhcp_values

  printf '== WiPi configuration ==\n'
  redacted_config
  printf '\n== Interface ==\n'
  ip -brief link show dev "${WIPI_INTERFACE}" 2>&1 || true
  ip -4 address show dev "${WIPI_INTERFACE}" 2>&1 || true

  printf '\n== Wireless capabilities ==\n'
  iw dev "${WIPI_INTERFACE}" info 2>&1 || true
  local phy_index
  phy_index=$(iw dev "${WIPI_INTERFACE}" info 2>/dev/null |
    awk '$1 == "wiphy" { print $2; exit }')
  if [[ ${phy_index} =~ ^[0-9]+$ ]]; then
    iw phy "phy${phy_index}" info 2>/dev/null |
      awk '
        /Supported interface modes:/ {show=1}
        show && /^[[:space:]]*\*[[:space:]]/ {print}
        /Frequencies:/ {freq=1}
        freq && /MHz/ {print}
        freq && NF == 0 {exit}
      ' || true
  fi
  iw dev "${WIPI_INTERFACE}" get power_save 2>/dev/null || true

  printf '\n== rfkill ==\n'
  rfkill list wifi 2>&1 || true

  printf '\n== NetworkManager ==\n'
  nmcli general status 2>&1 || true
  nmcli device status 2>&1 || true
  nmcli connection show "${CONNECTION_NAME}" 2>&1 |
    grep -E '^(GENERAL.STATE|GENERAL.DEVICES|connection.id|connection.interface-name|connection.autoconnect|802-11-wireless.(ssid|mode|band|channel|powersave|cloned-mac-address|channel-width)|802-11-wireless-security.(key-mgmt|proto|pairwise|group|pmf)|ipv4.(method|addresses|gateway|never-default|ignore-auto-dns)|ipv6.method)' ||
    true

  printf '\n== Associated clients ==\n'
  iw dev "${WIPI_INTERFACE}" station dump 2>&1 |
    awk '/^Station / || /signal:/ || /connected time:/' || true

  printf '\n== Routes and forwarding ==\n'
  ip -4 route show 2>&1 || true
  printf '\nWiPi policy rule:\n'
  policy_rule_text || true
  printf '\nWiPi routing table %s:\n' "${ROUTING_TABLE_ID}"
  ip -4 route show table "${ROUTING_TABLE_ID}" 2>&1 || true
  printf 'net.ipv4.ip_forward = %s\n' "$(read_ip_forwarding 2>/dev/null || printf unknown)"

  printf '\n== WiPi firewall ==\n'
  nft list table inet wipi_filter 2>&1 || printf 'No WiPi filter table.\n'
  nft list table ip wipi_nat 2>/dev/null || true

  printf '\n== WiPi DHCP/DNS service ==\n'
  systemctl --no-pager --full status "${DNS_SERVICE_NAME}" 2>&1 |
    tail -n 30 || true
  if [[ ${WIPI_MODE} == "routed" &&
    -n ${WIPI_UPSTREAM_INTERFACE} ]]; then
    load_pinned_runtime_metadata
    printf 'Pinned DNS servers:\n'
    if [[ -n ${PINNED_DNS_SERVERS} ]]; then
      printf '%s\n' "${PINNED_DNS_SERVERS}"
    else
      printf 'none\n'
    fi
  fi

  printf '\n== Recent NetworkManager AP logs ==\n'
  journalctl --no-pager -u NetworkManager --since '-30 minutes' 2>/dev/null |
    grep -Ei "${WIPI_INTERFACE}|${CONNECTION_NAME}" |
    tail -n 80 || true
}

show_credentials() {
  require_root
  [[ -r ${CONFIG_FILE} ]] || die "WiPi is not installed"
  set_defaults
  load_config
  validate_logical_settings
  printf 'SSID:     %s\n' "${WIPI_SSID}"
  printf 'Password: %s\n' "${WIPI_PASSWORD}"
}

uninstall_wipi() {
  require_root
  (($# <= 1)) || die "usage: sudo wipi uninstall [--keep-config]"
  local keep_config=0
  case ${1:-} in
    "") ;;
    --keep-config) keep_config=1 ;;
    *) die "usage: sudo wipi uninstall [--keep-config]" ;;
  esac

  if command_exists systemctl; then
    systemctl disable --now "${DNS_SERVICE_NAME}" >/dev/null 2>&1 || true
    systemctl disable --now "${SERVICE_NAME}" >/dev/null 2>&1 || true
  else
    service_stop
  fi
  stop_dnsmasq
  remove_firewall
  remove_policy_routing
  restore_ip_forwarding

  if command_exists nmcli; then
    if connection_exists; then
      nmcli connection delete "${CONNECTION_NAME}" >/dev/null
    fi
    if connection_exists_named "${LEGACY_CONNECTION_NAME}"; then
      nmcli connection delete "${LEGACY_CONNECTION_NAME}" >/dev/null
    fi
  fi

  rm -f "${UNIT_FILE}" "${DNS_UNIT_FILE}" "${ROUTING_TABLE_FILE}" \
    "${DISPATCHER_FILE}" "${INSTALLED_COMMAND}"
  rm -rf -- "${RUN_DIR}" "${STATE_DIR}"
  if ((keep_config == 0)); then
    rm -rf -- "${CONFIG_DIR}"
  fi
  command_exists systemctl && systemctl daemon-reload
  log "uninstalled WiPi-owned resources"
  ((keep_config == 0)) || log "preserved ${CONFIG_FILE}"
}

